{
  "name": "llama-server-configurator-frontend",
  "version": "1.1.1",
  "description": "Frontend for Llama Server Configurator",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "types:generate": "node tests/generate-types.mjs",
    "typecheck": "node tests/generate-types.mjs --check && tsc --noEmit",
    "test:gui": "node tests/gui-smoke.mjs",
    "benchmark:gui": "node tests/gui-benchmark.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  }
}
