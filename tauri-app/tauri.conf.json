{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLamaLauncher",
  "mainBinaryName": "llama-server-configurator",
  "version": "1.1.2",
  "identifier": "io.github.alexstapleton.llamalauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:14200",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Llama Server Configuration Manager",
        "width": 1200,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "label": "main",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src 'none'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; media-src 'none'; object-src 'none'; worker-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
